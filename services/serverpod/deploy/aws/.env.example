# /opt/nexo/.env en la VM (chmod 600). `tool/aws/deploy.sh` lo genera en el
# primer deploy con secretos aleatorios nuevos: este archivo sólo documenta
# las claves. Nunca se versiona un .env con valores.

# Host público: la IP de la VM con guiones + sslip.io.
NEXO_HOST=3-80-12-5.sslip.io
# Las URLs de archivos (fotos, avatares) las arma el servidor con este host.
SERVERPOD_API_SERVER_PUBLIC_HOST=api.3-80-12-5.sslip.io

# Postgres: la misma contraseña para el contenedor y para el servidor.
POSTGRES_PASSWORD=
SERVERPOD_PASSWORD_database=

# Secretos de Serverpod y del login.
SERVERPOD_PASSWORD_serviceSecret=
SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey=
SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper=
SERVERPOD_PASSWORD_emailSecretHashPepper=

# Agora (SDD 0006): con los dos, el servidor firma los tokens de video.
SERVERPOD_PASSWORD_agoraAppId=
SERVERPOD_PASSWORD_agoraAppCertificate=

# Email de los códigos de verificación (opcional). Sin los tres primeros,
# el código va al log del servidor (`docker compose logs server`).
#   Gmail: smtp.gmail.com, 587, la dirección y una contraseña de aplicación.
#   Brevo: smtp-relay.brevo.com, 587, el login SMTP y la clave SMTP.
SERVERPOD_PASSWORD_smtpHost=
SERVERPOD_PASSWORD_smtpUser=
SERVERPOD_PASSWORD_smtpPassword=
SERVERPOD_PASSWORD_smtpPort=587
SERVERPOD_PASSWORD_smtpFrom=
SERVERPOD_PASSWORD_smtpFromName=Nexo
